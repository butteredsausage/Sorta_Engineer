from picamera2 import Picamera2
import cv2
import numpy as np

# Initialize the camera
picam2 = Picamera2()
picam2.configure(picam2.create_preview_configuration(main={"size": (640, 480)}))
picam2.start()

print("Camera initialized. Detecting motion...")

# Define the region of interest (ROI) coordinates
roi_start = (200, 150)  # Top-left corner of the box
roi_end = (440, 330)    # Bottom-right corner of the box

# Read initial frame
initial_frame = picam2.capture_array()
initial_gray = cv2.cvtColor(initial_frame, cv2.COLOR_BGR2GRAY)
initial_gray = cv2.GaussianBlur(initial_gray, (21, 21), 0)

while True:
    # Capture next frame
    frame = picam2.capture_array()
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    gray = cv2.GaussianBlur(gray, (21, 21), 0)

    # Calculate the difference between frames
    diff = cv2.absdiff(initial_gray, gray)
    _, thresh = cv2.threshold(diff, 25, 255, cv2.THRESH_BINARY)

    # Focus only on the region of interest (ROI)
    roi_thresh = thresh[roi_start[1]:roi_end[1], roi_start[0]:roi_end[0]]
    motion = np.sum(roi_thresh) > 5000  # Adjust sensitivity as needed

    # Draw the box with appropriate color
    box_color = (0, 255, 0) if not motion else (0, 0, 255)  # Green for no motion, red for motion
    cv2.rectangle(frame, roi_start, roi_end, box_color, 2)

    # Display motion detection status
    status = "Motion Detected" if motion else "No Motion"
    print(status)

    # Display the frame
    cv2.imshow("Camera Feed", frame)
    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

# Clean up
cv2.destroyAllWindows()
picam2.stop()
